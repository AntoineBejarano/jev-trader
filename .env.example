# ============================================================
# JEV / OPENROUTER
# ============================================================

OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Chat-style base URL is kept for tooling, but Jev is called at /api/alpha/decisions.
JEV_BASE_URL=https://openrouter.ai/api/v1
JEV_TIMEOUT_SECONDS=10
JEV_FAILURE_TIMEOUT_SECONDS=30


# ============================================================
# EXCHANGE
# ============================================================

# Accepted aliases: binance, binance_usdm. Normalized to binance_usdm.
EXCHANGE=binance
TRADING_EXCHANGE=binance_usdm
TRADING_SYMBOLS=BTCUSDT

# Only required later for authenticated PAPER/testnet or LIVE execution
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Keep false initially
BINANCE_TESTNET=false


# ============================================================
# TRADING MODE
# ============================================================

# SHADOW | PAPER | LIVE
TRADING_MODE=SHADOW

# BASELINE | SCALP | DIRECTIONAL
TRADING_STRATEGY=BASELINE

# Required only for LIVE
LIVE_TRADING_CONFIRMATION=

DECISION_INTERVAL_SECONDS=5
PRIMARY_HORIZON_SECONDS=300


# ============================================================
# PAPER TRADING
# ============================================================

PAPER_INITIAL_BALANCE=10000
PAPER_CURRENCY=USDT

# Configure these according to the actual venue/account being simulated.
# Do not assume these are the real Binance fees.
PAPER_MAKER_FEE_BPS=0
PAPER_TAKER_FEE_BPS=0
PAPER_SLIPPAGE_BPS=1

# Explicit paper size. If PAPER_POSITION_NOTIONAL=0, MAX_POSITION_NOTIONAL is used.
PAPER_POSITION_NOTIONAL=0
TARGET_POSITION_EQUITY_PCT=0

# Assumed USD-M VIP0 Regular fees for SCALP profitability. Not account-specific.
SCALP_MAKER_FEE_BPS=2
SCALP_TAKER_FEE_BPS=5
SCALP_MIN_NET_EV_BPS=1.0
SCALP_MIN_PROBABILITY_EDGE=0.08
SCALP_MAX_NOISE=0.85
SCALP_MIN_POSITION_AGE_SECONDS=8
SCALP_MIN_SECONDS_BETWEEN_ORDERS=8
SCALP_REVERSE_ADVANTAGE_BPS=1.5
SCALP_HORIZONS_SECONDS=15,30,60,180,300


# ============================================================
# JEV DECISION POLICY
# ============================================================

# Experimental starting values — must be validated, not assumed optimal.
ENTRY_THRESHOLD=0.80
EVIDENCE_THRESHOLD=0.75
HOLD_THRESHOLD=0.55
CLOSE_THRESHOLD=0.70
REVERSE_THRESHOLD=0.88

# DIRECTIONAL_V1 research constants. Not claimed optimal.
DIR_ENTRY_CONFIDENCE=0.70
DIR_EXIT_OPPOSITE_CONFIDENCE=0.65
DIR_REVERSE_CONFIDENCE=0.75
DIR_CONFIRMATIONS_REQUIRED=2
DIR_HOLD_FLOOR=0.55
DIR_CLOSE_THESIS_FLOOR=0.50
DIR_THESIS_DECAY_CLOSE=0.20
DIR_REVERSE_MARGIN=0.10
DIR_REVERSE_CONFIRMATIONS=2
DIR_CLOSE_CONFIRMATIONS=2
DIR_SUPPORT_CONFIDENCE=0.62
DIR_HORIZON_WEIGHT_PRIMARY=1.0
DIR_HORIZON_WEIGHT_SUPPORT=0.55
DIR_HORIZON_WEIGHT_CONTEXT=0.20
DIR_REVERSAL_RISK_CLOSE=0.60
DIR_MOMENTUM_WEAKENING_CLOSE=0.60
DIR_GIVEBACK_CONTEXT_BPS=8.0
DIR_STALE_HORIZON_MULTIPLE=3.0

MIN_POSITION_AGE_SECONDS=15
MIN_FLAT_COOLDOWN_SECONDS=10
MIN_SECONDS_BETWEEN_ORDERS=10


# ============================================================
# RISK
# ============================================================

MAX_POSITION_NOTIONAL=1000
MAX_LEVERAGE=1
MAX_TOTAL_EXPOSURE=1000
MAX_SIMULTANEOUS_POSITIONS=1

MAX_LOSS_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DAILY_DRAWDOWN_PCT=3.0

MAX_CONSECUTIVE_LOSSES=5
MAX_ORDERS_PER_MINUTE=6

# 0 = no strategic maximum duration. Emergency/risk exits still apply.
MAX_POSITION_DURATION_SECONDS=0


# ============================================================
# SAFETY / HEALTH
# ============================================================

STALE_MARKET_DATA_TIMEOUT_SECONDS=10
OPEN_INTEREST_POLL_SECONDS=5
KILL_SWITCH=false


# ============================================================
# DATABASE
# ============================================================

# Local tests may use SQLite. Operator / Railway runs require PostgreSQL.
# Railway: attach a Postgres plugin and set DATABASE_URL to
# ${{Postgres.DATABASE_PRIVATE_URL}} (or DATABASE_URL from the plugin).
DATABASE_URL=sqlite:///./jev_trader.db


# ============================================================
# API / DASHBOARD
# ============================================================

# Local: 127.0.0.1. Railway / Docker: 0.0.0.0 (also auto-set when RAILWAY_ENVIRONMENT exists).
# Railway injects PORT; do not hardcode it in the service.
HOST=127.0.0.1
PORT=8000


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
ENVIRONMENT=development

# Provenance for frozen measurement experiments. run_id is created per process start.
EXPERIMENT_ID=scalp-v3-calibration
EXPERIMENT_FROZEN=false
